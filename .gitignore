# Dependencies
node_modules/
.pnp/
.pnp.js

# Production build
dist/
build/

# Environment variables / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Environment example files are allowed
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
*.log
logs/

# Vite
.vite/

# IDE / Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml
*.ipr
*.iws

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Windows temporary files
*.tmp
*.temp

# Testing / coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache

# TypeScript
*.tsbuildinfo

# Local database / temporary database files
*.db
*.sqlite
*.sqlite3

# Temporary files
*.swp
*.swo
*.bak
*.backup

# Netlify
.netlify/

# Vercel
.vercel/

# Local environment/config files
config.local.*
secrets/